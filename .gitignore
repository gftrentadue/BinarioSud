# VS Code: si versionano le configurazioni condivise di progetto
# (launch.json/tasks.json sono presenti e utili al team), mentre si ignorano
# i file macchina-specifici, le impostazioni utente e gli artefatti di estensioni.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/*.code-snippets
# Estensione "Local History" e pacchetti VSIX
.history/
*.vsix

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code: impostazioni personali/locali (percorsi macchina-specifici)
.claude/settings.local.json
